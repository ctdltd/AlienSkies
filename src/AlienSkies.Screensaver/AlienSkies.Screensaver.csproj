<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Lets the project build (not run) on Linux/macOS CI too. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>AlienSkies</AssemblyName>
    <RootNamespace>AlienSkies.Screensaver</RootNamespace>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>

  <!-- The full catalogs bundled into the Android APK (tools/build_catalog.py output), embedded here too so the
       single-file .scr shows the whole sky. Without them it falls back to the small samples in AlienSkies.Core. -->
  <ItemGroup>
    <EmbeddedResource Include="..\AlienSkies.Android\Assets\data\*.csv" LogicalName="AlienSkies.Full.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AlienSkies.Core\AlienSkies.Core.csproj" />
    <ProjectReference Include="..\AlienSkies.Rendering\AlienSkies.Rendering.csproj" />
  </ItemGroup>

</Project>
